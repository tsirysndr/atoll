{
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.2.5/"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "check": "deno task lume --help",
    "deploy": "deno run -A deploy.ts"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "deploy": {
    "org": "tsirysndr",
    "app": "atoll-docs"
  }
}
