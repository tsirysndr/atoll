{
	"name": "atoll-email",
	"main": "src/index.js",
	"compatibility_date": "2025-09-01",
	"send_email": [{ "name": "EMAIL" }],
	"kv_namespaces": [
		{
			"binding": "IDEMPOTENCY",
			// Replace with the id printed by: wrangler kv namespace create IDEMPOTENCY
			"id": "REPLACE_WITH_KV_NAMESPACE_ID"
		}
	],
	"vars": {
		"SENDER": "noreply@example.com",
		"SENDER_NAME": "PDS"
	}
}
