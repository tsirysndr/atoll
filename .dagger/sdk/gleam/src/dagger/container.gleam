          WithRunShell(value) -> #(
            "shell",
            query.List(list.map(value, fn(item) { query.String(item) })),
          )

          WithRunDisableDaggerInDagger(value) -> #(
            "disableDaggerInDagger",
            query.Boolean(value),
          )

          WithRunExperimentalPrivilegedNesting(value) -> #(
            "experimentalPrivilegedNesting",
            query.Boolean(value),
          )

          WithRunInsecureRootCapabilities(value) -> #(
            "insecureRootCapabilities",
            query.Boolean(value),
          )
        }
      }),
    )

  let selection = query.select(self.selection, "withRun", arguments)

  types.Container(selection)
}

pub type TerminalOption {
  /// If set, override the container's default terminal command and invoke these command arguments instead.
  TerminalCmd(List(String))
  /// Disable Dagger API access for the executed command. By default, commands can connect to the current Dagger engine.
  TerminalDisableDaggerInDagger(Bool)
  TerminalExperimentalPrivilegedNesting(Bool)
  /// Execute the command with all root capabilities. This is similar to running a command with "sudo" or executing "docker run" with the "--privileged" flag. Containerization does not provide any security guarantees when using this option. It should only be used when absolutely necessary and only with trusted commands.
  TerminalInsecureRootCapabilities(Bool)
}

/// Opens an interactive terminal for this container using its configured default terminal command if not overridden by args (or sh as a fallback default).
pub fn terminal(self: types.Container) -> types.Container {
  terminal_with(self, [])
}

/// Opens an interactive terminal for this container using its configured default terminal command if not overridden by args (or sh as a fallback default).
pub fn terminal_with(
  self: types.Container,
  options: List(TerminalOption),
) -> types.Container {
  let arguments = []

  let arguments =
    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          TerminalCmd(value) -> #(
            "cmd",
            query.List(list.map(value, fn(item) { query.String(item) })),
          )

          TerminalDisableDaggerInDagger(value) -> #(
            "disableDaggerInDagger",
            query.Boolean(value),
          )

          TerminalExperimentalPrivilegedNesting(value) -> #(
            "experimentalPrivilegedNesting",
            query.Boolean(value),
          )

          TerminalInsecureRootCapabilities(value) -> #(
            "insecureRootCapabilities",
            query.Boolean(value),
          )
        }
      }),
    )

  let selection = query.select(self.selection, "terminal", arguments)

  types.Container(selection)
}

/// Configures all GPUs available on the host to be accessible to this container.
///
/// This currently works with NVIDIA devices only, and requires the engine to run with GPU support enabled.
pub fn with_gpu(self: types.Container) -> types.Container {
  let arguments = []

  let selection = query.select(self.selection, "withGPU", arguments)

  types.Container(selection)
}

/// Configures the provided list of devices to be accessible to this container.
///
/// This currently works for Nvidia devices only.
/// Deprecated: Use "withGPU" instead, which exposes all GPUs available on the host.
pub fn experimental_with_gpu(
  self: types.Container,
  devices: List(String),
) -> types.Container {
  let arguments = [
    #("devices", query.List(list.map(devices, fn(item) { query.String(item) }))),
  ]

  let selection = query.select(self.selection, "experimentalWithGPU", arguments)

  types.Container(selection)
}

/// Configures all available GPUs on the host to be accessible to this container.
///
/// This currently works for Nvidia devices only.
/// Deprecated: Use "withGPU" instead.
pub fn experimental_with_all_gp_us(self: types.Container) -> types.Container {
  let arguments = []

  let selection =
    query.select(self.selection, "experimentalWithAllGPUs", arguments)

  types.Container(selection)
}

pub type AsServiceOption {
  /// Command to run instead of the container's default command (e.g., ["go", "run", "main.go"]).
  ///
  /// If empty, the container's default command is used.
  AsServiceArgs(List(String))
  /// If the container has an entrypoint, prepend it to the args.
  AsServiceUseEntrypoint(Bool)
  /// Disable Dagger API access for the executed command. By default, commands can connect to the current Dagger engine.
  AsServiceDisableDaggerInDagger(Bool)
  AsServiceExperimentalPrivilegedNesting(Bool)
  /// Connect Dagger clients started by the command to the current engine as new sessions, instead of as clients of the current session. Each connection gets its own session, released when that client closes.
  ///
  /// The command reaches the engine through DAGGER_ENGINE, so SDKs run a Dagger CLI: set _EXPERIMENTAL_DAGGER_CLI_BIN to one in the container, or let the SDK download one.
  ///
  /// Cannot be combined with "disableDaggerInDagger".
  AsServiceDaggerInDaggerNewSession(Bool)
  /// Execute the command with all root capabilities. This is similar to running a command with "sudo" or executing "docker run" with the "--privileged" flag. Containerization does not provide any security guarantees when using this option. It should only be used when absolutely necessary and only with trusted commands.
  AsServiceInsecureRootCapabilities(Bool)
  /// Replace "${VAR}" or "$VAR" in the args according to the current environment variables defined in the container (e.g. "/$VAR/foo").
  AsServiceExpand(Bool)
  /// If set, skip the automatic init process injected into containers by default.
  ///
  /// This should only be used if the user requires that their exec process be the pid 1 process in the container. Otherwise it may result in unexpected behavior.
  AsServiceNoInit(Bool)
}

/// Turn the container into a Service.
///
/// Be sure to set any exposed ports before this conversion.
pub fn as_service(self: types.Container) -> types.Service {
  as_service_with(self, [])
}

/// Turn the container into a Service.
///
/// Be sure to set any exposed ports before this conversion.
pub fn as_service_with(
  self: types.Container,
  options: List(AsServiceOption),
) -> types.Service {
  let arguments = []

  let arguments =
    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          AsServiceArgs(value) -> #(
            "args",
            query.List(list.map(value, fn(item) { query.String(item) })),
          )

          AsServiceUseEntrypoint(value) -> #(
            "useEntrypoint",
            query.Boolean(value),
          )

          AsServiceDisableDaggerInDagger(value) -> #(
            "disableDaggerInDagger",
            query.Boolean(value),
          )

          AsServiceExperimentalPrivilegedNesting(value) -> #(
            "experimentalPrivilegedNesting",
            query.Boolean(value),
          )

          AsServiceDaggerInDaggerNewSession(value) -> #(
            "daggerInDaggerNewSession",
            query.Boolean(value),
          )

          AsServiceInsecureRootCapabilities(value) -> #(
            "insecureRootCapabilities",
            query.Boolean(value),
          )

          AsServiceExpand(value) -> #("expand", query.Boolean(value))

          AsServiceNoInit(value) -> #("noInit", query.Boolean(value))
        }
      }),
    )

  let selection = query.select(self.selection, "asService", arguments)

  types.Service(selection)
}

pub type UpOption {
  /// Bind each tunnel port to a random port on the host.
  UpRandom(Bool)
  /// List of frontend/backend port mappings to forward.
  ///
  /// Frontend is the port accepting traffic on the host, backend is the service port.
  UpPorts(List(types.PortForward))
  /// Command to run instead of the container's default command (e.g., ["go", "run", "main.go"]).
  ///
  /// If empty, the container's default command is used.
  UpArgs(List(String))
  /// If the container has an entrypoint, prepend it to the args.
  UpUseEntrypoint(Bool)
  /// Disable Dagger API access for the executed command. By default, commands can connect to the current Dagger engine.
  UpDisableDaggerInDagger(Bool)
  UpExperimentalPrivilegedNesting(Bool)
  /// Connect Dagger clients started by the command to the current engine as new sessions, instead of as clients of the current session. Each connection gets its own session, released when that client closes.
  ///
  /// The command reaches the engine through DAGGER_ENGINE, so SDKs run a Dagger CLI: set _EXPERIMENTAL_DAGGER_CLI_BIN to one in the container, or let the SDK download one.
  ///
  /// Cannot be combined with "disableDaggerInDagger".
  UpDaggerInDaggerNewSession(Bool)
  /// Execute the command with all root capabilities. This is similar to running a command with "sudo" or executing "docker run" with the "--privileged" flag. Containerization does not provide any security guarantees when using this option. It should only be used when absolutely necessary and only with trusted commands.
  UpInsecureRootCapabilities(Bool)
  /// Replace "${VAR}" or "$VAR" in the args according to the current environment variables defined in the container (e.g. "/$VAR/foo").
  UpExpand(Bool)
  /// If set, skip the automatic init process injected into containers by default.
  ///
  /// This should only be used if the user requires that their exec process be the pid 1 process in the container. Otherwise it may result in unexpected behavior.
  UpNoInit(Bool)
}

/// Starts a Service and creates a tunnel that forwards traffic from the caller's network to that service.
///
/// Be sure to set any exposed ports before calling this api.
pub fn up(self: types.Container) -> Result(Option(Nil), DaggerError) {
  up_with(self, [])
}

/// Starts a Service and creates a tunnel that forwards traffic from the caller's network to that service.
///
/// Be sure to set any exposed ports before calling this api.
pub fn up_with(
  self: types.Container,
  options: List(UpOption),
) -> Result(Option(Nil), DaggerError) {
  let arguments = []

  let arguments =
    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          UpRandom(value) -> #("random", query.Boolean(value))

          UpPorts(value) -> #(
            "ports",
            query.List(
              list.map(value, fn(item) { types.encode_port_forward(item) }),
            ),
          )

          UpArgs(value) -> #(
            "args",
            query.List(list.map(value, fn(item) { query.String(item) })),
          )

          UpUseEntrypoint(value) -> #("useEntrypoint", query.Boolean(value))

          UpDisableDaggerInDagger(value) -> #(
            "disableDaggerInDagger",
            query.Boolean(value),
          )

          UpExperimentalPrivilegedNesting(value) -> #(
            "experimentalPrivilegedNesting",
            query.Boolean(value),
          )

          UpDaggerInDaggerNewSession(value) -> #(
            "daggerInDaggerNewSession",
            query.Boolean(value),
          )

          UpInsecureRootCapabilities(value) -> #(
            "insecureRootCapabilities",
            query.Boolean(value),
          )

          UpExpand(value) -> #("expand", query.Boolean(value))

          UpNoInit(value) -> #("noInit", query.Boolean(value))
        }
      }),
    )

  let selection = query.select(self.selection, "up", arguments)

  query.execute(
    selection,
    decode.optional(decode.map(decode.dynamic, fn(_) { Nil })),
  )
}
