      list.map(options, fn(option) {
        case option {
          FormatIdentifiersAcronyms(value) -> #(
            "acronyms",
            types.encode_acronym_style(value),
          )

          FormatIdentifiersVersion(value) -> #("version", query.String(value))
        }
      }),
    )

  let selection = query.select(self.selection, "formatIdentifiers", arguments)

  query.execute(selection, decode.list(decode.string))
}

/// The acronyms and terms used to parse and format identifiers.
pub fn naming_dictionary(
  self: types.Query,
) -> Result(List(types.NamingTerm), DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "namingDictionary", arguments)

  query.execute_with_children(
    selection,
    "id",
    decode.list(
      decode.map(decode.at(["id"], decode.string), fn(id) {
        types.NamingTerm(query.load(selection, "NamingTerm", id))
      }),
    ),
  )
}

/// Load a GraphQL introspection schema for merging.
pub fn schema(self: types.Query, json: types.Json) -> types.Schema {
  let arguments = [#("json", types.encode_json(json))]

  let selection = query.select(self.selection, "schema", arguments)

  types.Schema(selection)
}

pub type EnvFileOption {
  /// Replace "${VAR}" or "$VAR" with the value of other vars
  EnvFileExpand(Bool)
}

/// Initialize an environment file
pub fn env_file(self: types.Query) -> types.EnvFile {
  env_file_with(self, [])
}

/// Initialize an environment file
pub fn env_file_with(
  self: types.Query,
  options: List(EnvFileOption),
) -> types.EnvFile {
  let arguments = []

  let arguments =
    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          EnvFileExpand(value) -> #("expand", query.Boolean(value))
        }
      }),
    )

  let selection = query.select(self.selection, "envFile", arguments)

  types.EnvFile(selection)
}

/// Resolve external references only.
pub fn address(self: types.Query, value: String) -> types.Address {
  let arguments = [#("value", query.String(value))]

  let selection = query.select(self.selection, "address", arguments)

  types.Address(selection)
}

/// Detect and return the current workspace.
pub fn current_workspace(self: types.Query) -> types.Workspace {
  let arguments = []

  let selection = query.select(self.selection, "currentWorkspace", arguments)

  types.Workspace(selection)
}
