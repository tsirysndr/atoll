///
/// Pass from to compare against an earlier workspace state. Omitting it preserves the cumulative behavior used by clients from before this argument was added.
pub fn changes_with(
  self: types.Workspace,
  options: List(ChangesOption),
) -> types.Changeset {
  let arguments = []

  let arguments =
    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          ChangesFrom(value) -> #("from", query.Reference(value.selection))
        }
      }),
    )

  let selection = query.select(self.selection, "changes", arguments)

  types.Changeset(selection)
}

pub type ExportOption {
  /// Destination checkout path on the calling client. Relative paths start at the client's working directory. Omit to use the calling client's current local workspace root.
  ExportPath(String)
  /// Earlier workspace state to compare against. For Git integration, live inputs are snapshotted at export time; use a snapshot to retain the baseline of a previous export.
  ExportFrom(types.Workspace)
}

/// Write this workspace's commits and pending changes to a checkout on the calling client.
///
/// Path selects the destination; omitting it uses the calling client's current local workspace root, including when exporting a snapshot or committed workspace. Exported file paths are relative to the workspace root regardless of its working directory. This writes only to the client making the call, never the source's client.
///
/// A live workspace exported to its own checkout applies only its overlay edits, without capturing the whole checkout. This also applies with an explicit path. Pass from with the same live base to apply only changes since that overlay state.
///
/// Other exports integrate divergent commits by cherry-picking, preserve unrelated checkout edits, and refuse conflicts. Live inputs are snapshotted automatically; capturing untracked source files requires interactive approval. Stable inputs retain their baseline. Pass from to save only work since an earlier source value, including previously saved pending edits that are now committed.
pub fn export(self: types.Workspace) -> Result(Nil, DaggerError) {
  export_with(self, [])
}

/// Write this workspace's commits and pending changes to a checkout on the calling client.
///
/// Path selects the destination; omitting it uses the calling client's current local workspace root, including when exporting a snapshot or committed workspace. Exported file paths are relative to the workspace root regardless of its working directory. This writes only to the client making the call, never the source's client.
///
/// A live workspace exported to its own checkout applies only its overlay edits, without capturing the whole checkout. This also applies with an explicit path. Pass from with the same live base to apply only changes since that overlay state.
///
/// Other exports integrate divergent commits by cherry-picking, preserve unrelated checkout edits, and refuse conflicts. Live inputs are snapshotted automatically; capturing untracked source files requires interactive approval. Stable inputs retain their baseline. Pass from to save only work since an earlier source value, including previously saved pending edits that are now committed.
pub fn export_with(
  self: types.Workspace,
  options: List(ExportOption),
) -> Result(Nil, DaggerError) {
  let arguments = []

  let arguments =
    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          ExportPath(value) -> #("path", query.String(value))

          ExportFrom(value) -> #("from", query.Reference(value.selection))
        }
      }),
    )

  let selection = query.select(self.selection, "export", arguments)

  query.execute(selection, decode.map(decode.dynamic, fn(_) { Nil }))
}

pub type ConfigReadOption {
  /// Dotted key path (e.g. modules.greeter.source). Empty for full config.
  ConfigReadKey(String)
  /// Include the selected environment, user overrides, and legacy workspace settings.
  ConfigReadEffective(Bool)
}

/// Read a configuration value from dagger.toml.
///
/// If key is empty, returns the full config.
///
/// If key points to a scalar, returns the value.
///
/// If key points to a table, returns flattened dotted-key output.
pub fn config_read(self: types.Workspace) -> Result(String, DaggerError) {
  config_read_with(self, [])
}

/// Read a configuration value from dagger.toml.
///
/// If key is empty, returns the full config.
///
/// If key points to a scalar, returns the value.
///
/// If key points to a table, returns flattened dotted-key output.
pub fn config_read_with(
  self: types.Workspace,
  options: List(ConfigReadOption),
) -> Result(String, DaggerError) {
  let arguments = []

  let arguments =
    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          ConfigReadKey(value) -> #("key", query.String(value))

          ConfigReadEffective(value) -> #("effective", query.Boolean(value))
        }
      }),
    )

  let selection = query.select(self.selection, "configRead", arguments)

  query.execute(selection, decode.string)
}

/// Installed name of the module selected as the workspace main, or an empty string when none is selected.
///
/// Reflects the selected env's effective view. Fails if several modules are selected.
pub fn main(self: types.Workspace) -> Result(String, DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "main", arguments)

  query.execute(selection, decode.string)
}

/// Compatibility alias for main.
/// Deprecated: Use main.
pub fn entrypoint(self: types.Workspace) -> Result(String, DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "entrypoint", arguments)

  query.execute(selection, decode.string)
}

/// List named environments defined in the workspace configuration.
pub fn env_list(self: types.Workspace) -> Result(List(String), DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "envList", arguments)

  query.execute(selection, decode.list(decode.string))
}

/// List modules defined in the workspace configuration.
///
/// Reflects the selected env's effective view.
pub fn modules(
  self: types.Workspace,
) -> Result(List(types.WorkspaceModule), DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "modules", arguments)

  query.execute_with_children(
    selection,
    "id",
    decode.list(
      decode.map(decode.at(["id"], decode.string), fn(id) {
        types.WorkspaceModule(query.load(selection, "WorkspaceModule", id))
      }),
    ),
  )
}

/// Return a module defined in the workspace configuration.
///
/// Reflects the selected env's effective view.
pub fn module(self: types.Workspace, name: String) -> types.WorkspaceModule {
  let arguments = [#("name", query.String(name))]

  let selection = query.select(self.selection, "module", arguments)

  types.WorkspaceModule(selection)
}

/// Load a module source from a path within the workspace.
///
/// Relative paths (e.g., "foo") resolve from the workspace cwd; absolute paths (e.g., "/foo") resolve from the workspace root.
///
/// Fails if the path does not point to an initialized module.
pub fn module_source(
  self: types.Workspace,
  path: String,
) -> types.ModuleSource {
  let arguments = [#("path", query.String(path))]

  let selection = query.select(self.selection, "moduleSource", arguments)

  types.ModuleSource(selection)
}

/// Current location within the workspace root.
///
/// The workspace root is returned as "/".
///
/// Relative paths in workspace APIs resolve from here.
pub fn cwd(self: types.Workspace) -> Result(String, DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "cwd", arguments)

  query.execute(selection, decode.string)
}

pub type ArtifactsOption {
  /// Only include artifacts matching these path patterns, as with checks and services. A path selects that path and its children.
  ArtifactsInclude(List(String))
}

/// Discover static object artifacts from workspace modules without evaluating their values.
///
/// Omits the paths that the workspace's check.skip, generate.skip, and up.skip settings skip.
pub fn artifacts(self: types.Workspace) -> types.Artifacts {
  artifacts_with(self, [])
}

/// Discover static object artifacts from workspace modules without evaluating their values.
///
/// Omits the paths that the workspace's check.skip, generate.skip, and up.skip settings skip.
pub fn artifacts_with(
  self: types.Workspace,
  options: List(ArtifactsOption),
) -> types.Artifacts {
  let arguments = []

  let arguments =
    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          ArtifactsInclude(value) -> #(
            "include",
            query.List(list.map(value, fn(item) { query.String(item) })),
          )
        }
      }),
    )

  let selection = query.select(self.selection, "artifacts", arguments)

  types.Artifacts(selection)
}

pub type MigrateOption {
  /// Additional local modules to migrate. Relative paths start at the workspace cwd; absolute paths start at the workspace root.
  MigrateModules(List(String))
}

/// Plan the explicit migration needed for the current workspace.
///
/// Include installed local modules and their local dependencies. Other module candidates remain unchanged unless selected.
///
/// The returned plan has an empty changeset and no steps when no migration is needed.
pub fn migrate(self: types.Workspace) -> types.WorkspaceMigration {
  migrate_with(self, [])
}

/// Plan the explicit migration needed for the current workspace.
///
/// Include installed local modules and their local dependencies. Other module candidates remain unchanged unless selected.
///
/// The returned plan has an empty changeset and no steps when no migration is needed.
pub fn migrate_with(
  self: types.Workspace,
  options: List(MigrateOption),
) -> types.WorkspaceMigration {
  let arguments = []

  let arguments =
    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          MigrateModules(value) -> #(
            "modules",
            query.List(list.map(value, fn(item) { query.String(item) })),
          )
        }
      }),
    )

  let selection = query.select(self.selection, "migrate", arguments)

  types.WorkspaceMigration(selection)
}

/// Canonical Dagger address of the workspace location, or an opaque identity for synthetic workspaces.
pub fn address(self: types.Workspace) -> Result(String, DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "address", arguments)

  query.execute(selection, decode.string)
}
