    list.append(
      arguments,
      list.map(options, fn(option) {
        case option {
          SpawnExpertise(value) -> #(
            "expertise",
            query.List(
              list.map(value, fn(item) { query.Reference(item.selection) }),
            ),
          )

          SpawnName(value) -> #("name", query.String(value))

          SpawnHandle(value) -> #("handle", query.String(value))

          SpawnState(value) -> #("state", types.encode_agent_state(value))

          SpawnParentHandle(value) -> #("parentHandle", query.String(value))

          SpawnError(value) -> #("error", query.String(value))
        }
      }),
    )

  let selection = query.select(self.selection, "spawn", arguments)

  query.execute(
    selection,
    decode.map(decode.string, fn(id) {
      types.Agent(query.load(selection, "Agent", id))
    }),
  )
}

/// Reconstruct a spawned agent from its runtime handle.
///
/// This is the lookup spawn pins its result's identity through: the returned handle's ID is an honest, replayable chain denoting the one instance the spawn minted. It never creates an instance itself.
pub fn agent(self: types.Llm, handle: String, name: String) -> types.Agent {
  let arguments = [
    #("handle", query.String(handle)),
    #("name", query.String(name)),
  ]

  let selection = query.select(self.selection, "agent", arguments)

  types.Agent(selection)
}

/// Report whether anything is queued to send to the model: an unsent prompt or unevaluated tool results. When true, another step will do work; when false, the turn is complete.
pub fn has_pending(self: types.Llm) -> Result(Bool, DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "hasPending", arguments)

  query.execute(selection, decode.bool)
}

/// Fork the conversation, so that otherwise-identical follow-ups evaluate independently instead of deduplicating to a single cached result.
pub fn fork(self: types.Llm, label: String) -> types.Llm {
  let arguments = [#("label", query.String(label))]

  let selection = query.select(self.selection, "fork", arguments)

  types.Llm(selection)
}

/// Render documentation for the tools currently exposed to the model.
pub fn tools(self: types.Llm) -> Result(String, DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "tools", arguments)

  query.execute(selection, decode.string)
}

/// The cumulative token usage, summed across every API call in the conversation.
pub fn token_usage(self: types.Llm) -> types.LlmTokenUsage {
  let arguments = []

  let selection = query.select(self.selection, "tokenUsage", arguments)

  types.LlmTokenUsage(selection)
}

/// estimated number of tokens currently occupying the context window; unlike tokenUsage this is not cumulative over the session
pub fn context_tokens(self: types.Llm) -> Result(Int, DaggerError) {
  let arguments = []

  let selection = query.select(self.selection, "contextTokens", arguments)

  query.execute(selection, decode.int)
}
